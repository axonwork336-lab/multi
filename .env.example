# Copy this file to .env and fill in real values for LOCAL DEVELOPMENT.
# On Railway/LangGraph Platform, set these as deployment env vars/secrets
# instead - .env is not used in production, only by `python main.py`,
# `uvicorn app:app`, or `langgraph dev` run locally.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=10
# The six reply verifiers (invented branch, invented date/time,
# fabricated complaint confirmation, fabricated handoff confirmation,
# doctor-roster re-offer, unauthorised gynaecology). Now ON by default -
# each one re-asks the model once, with a targeted correction, when a
# reply asserts something no tool result in the conversation supports.
# Set to false to go back to log-only (the reply is delivered unchanged
# and only a warning is written).
BRANCH_VERIFIER_STRICT=true

# Which country a BARE LOCAL number ("01155611045") belongs to when the
# client's own config gives no usable signal. Normally irrelevant: the
# country is taken from the client's `timezone` column first
# (Africa/Cairo -> 20, Asia/Riyadh -> 966), then from `phone_example`.
# If set (non-empty), this OVERRIDES client_config.csv's base_url column
# for every client. Leave empty to let the CSV / per-client value win.
BOOKING_API_BASE_URL=
BOOKING_API_TIMEOUT_SECONDS=15

# dummy = no external provider; TEST_OTP below is accepted as the code.
# authentica = the real SMS provider (needs AUTHENTICA_API_KEY).
OTP_PROVIDER=dummy
TEST_OTP=123456
AUTHENTICA_API_KEY=
AUTHENTICA_BASE_URL=http://api.authentica.sa/api/v2
AUTHENTICA_TEMPLATE_ID=31
AUTHENTICA_FALLBACK_EMAIL=

DEFAULT_COUNTRY_CODE=20

# Where client_config.csv / dialect_templates.csv are looked for. Leave
# empty to use the defaults (a `data/` folder next to the code, then the
# project root itself).
AGENT_DATA_DIR=
LOG_LEVEL=INFO

# ==========================================================
# DOCTORS / SPECIALTIES API
# ==========================================================
# If set, this OVERRIDES the per-client doctors_base_url for EVERY
# client - only appropriate for a single-tenant deployment. Leave empty
# so each client uses its own configured URL; a client with none falls
# back to its base_url.
DOCTORS_API_BASE_URL=

# How far ahead to search for doctor availability, and how long a
# fetched doctor roster stays reusable (a latency shield, not a cache of
# record - the roster does change).
DOCTOR_AVAILABILITY_WINDOW_DAYS=14
DOCTOR_LIST_CACHE_SECONDS=90

# ==========================================================
# COMPLAINT DELIVERY
# ==========================================================
# Recipients come from each client's own complaint_email_to column; this
# is only the transport. COMPLAINT_WEBHOOK_URL is the recommended route
# (n8n does the sending, and its network path is already proven for this
# system). Direct SMTP is the fallback - note that outbound SMTP from
# Railway has hit unresolvable connection timeouts in practice.
#
# The app logs a loud warning at startup if a client expects complaints
# and NEITHER transport is configured.
COMPLAINT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Auto-detected from the port (465 = implicit SSL, 587 = STARTTLS).
# Only set these to override that.
SMTP_USE_SSL=
SMTP_USE_TLS=

# ==========================================================
# SESSIONS / HISTORY
# ==========================================================
# Silence past this and the next message starts a brand new
# conversation (new greeting, empty history).
SESSION_TIMEOUT_SECONDS=3600

# The shorter grace period that applies specifically after a
# cancellation completes. A follow-up inside this window continues the
# same conversation; only silence past it starts fresh.
POST_SUCCESS_TIMEOUT_SECONDS=600

# How many recent messages are sent to the LLM each turn. The
# checkpointer still keeps the FULL history - this only caps what goes
# into the prompt, so a long conversation doesn't grow without bound.
MAX_HISTORY_MESSAGES=40

# Fallback timezone for a client row missing the `timezone` column.
# Per-client values from that column always win.
DEFAULT_TIMEZONE=Asia/Riyadh

# Set automatically by Railway - do not set manually for deployment.
PORT=8000

# ==========================================================
# MULTI-AGENT (see README_MULTIAGENT.md)
# ==========================================================
# All four are optional - the defaults shown are what runs if you omit
# them. They exist so the multi-agent layer can be dialled back without
# a code change if anything ever misbehaves in production.

# false -> rebuilds the exact pre-multi-agent graph (one agent, full
# prompt, all 28 tools). The master kill switch.
MULTI_AGENT_ENABLED=true

# false -> each specialist still gets its own scoped PROMPT but is bound
# to every tool. Use if a flow ever stalls for want of a tool.
AGENT_TOOL_SCOPING=true

# deterministic (default) = regex cues, zero extra LLM calls, fully
# reproducible. llm = a small classification call on ambiguous turns.
ROUTER_MODE=deterministic

# false -> turns off the shared reply normalizer (filler/narration/
# re-introduction stripping). The format contract in the prompt stays.
REPLY_NORMALIZATION_ENABLED=true

# ==========================================================
# INTERIM "PLEASE WAIT" MESSAGES (progress.py)
# ==========================================================
# OFF by default. /chat is request/response, so an interim line returned
# inside that response would reach the patient in the same instant as the
# answer. To arrive WHILE a tool is running it has to be pushed to a
# second webhook - normally an n8n branch that forwards to Messenger.

PROGRESS_ENABLED=false

# webhook -> POST to PROGRESS_WEBHOOK_URL
# log     -> just log the line. Use this first, to see and tune the
#            wording locally before wiring anything up in n8n.
PROGRESS_MODE=webhook
PROGRESS_WEBHOOK_URL=

# How long the turn must already have been running before the patient is
# told to wait. Most tool calls finish well inside this, so most turns
# still produce exactly one message.
PROGRESS_DELAY_SECONDS=1.5
PROGRESS_TIMEOUT_SECONDS=5
